# shop133 — plantilla de variables de entorno para docker-compose
#
# Copia este archivo a .env antes del primer "docker compose up":
#   Copy-Item .env.example .env
#
# .env esta en .gitignore. Nunca commitees credenciales reales.

# --- SQL Server ---------------------------------------------------------
# Debe cumplir la politica de contrasenas de SQL Server (8+ caracteres, con
# mayusculas, minusculas, digitos y simbolos). Si no la cumple, el contenedor
# arranca y muere sin mensaje evidente.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# --- Logins por servicio (Fase 0.4) -------------------------------------
# Un login por servicio, con permiso db_owner SOLO sobre su propia base. Es la
# regla 1 de CLAUDE.md aplicada por el motor: orders_user no puede abrir
# CatalogDb ni queriendo.
#
# Se crean con CHECK_POLICY = ON, asi que estas contrasenas tambien tienen que
# cumplir la politica de SQL Server. Si una no la cumple, el contenedor db-init
# sale con error y el mensaje no menciona la politica.
CATALOG_DB_PASSWORD=Catalog@Passw0rd
ORDERS_DB_PASSWORD=Orders@Passw0rd
INVENTORY_DB_PASSWORD=Inventory@Passw0rd
PAYMENTS_DB_PASSWORD=Payments@Passw0rd
# La quinta base, anadida en 4.6. Notifications la necesita para poder ser
# idempotente (regla 6): sin una fila que consultar no hay guarda posible.
NOTIFICATIONS_DB_PASSWORD=Notifications@Passw0rd

# --- RabbitMQ -----------------------------------------------------------
# guest/guest solo funciona desde localhost, que es justo nuestro caso en
# desarrollo. Habra que cambiarlo si algun dia se expone fuera del host.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
