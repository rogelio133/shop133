{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 6.2. La unica direccion que este proyecto conoce: la regla 3 de CLAUDE.md en forma de
  // configuracion. Aqui NO aparece el puerto de ningun servicio (5124 Catalog, 5189 Orders).
  //
  // La seccion se llama "Gateway" y no "Services": un plural invita a que la siguiente clave
  // sea "Services:CatalogBaseUrl", que es la regla 3 rota por autocompletado. Una seccion
  // "Gateway" solo puede ganar propiedades DEL Gateway.
  //
  // No va en User Secrets porque no es un secreto — precedente de Services:CatalogBaseUrl
  // (2.3) y Payments:DeclineAmountAbove (3.5). Se sobreescribe con Gateway__BaseUrl el dia
  // que el frontend tenga contenedor, y entonces sera el nombre del servicio de compose.
  //
  // 127.0.0.1 y no localhost, a proposito: 2.3 midio que un rechazo de conexion en localhost
  // cuesta 4,13 s porque resuelve a ::1 Y a 127.0.0.1 (dos SocketException por peticion),
  // frente a 2,03 s con el literal. Con el timeout en 5 s, localhost se comeria el 83 % del
  // presupuesto de fallo delante de un usuario. 2.4 ya eligio el literal por lo mismo.
  "Gateway": {
    "BaseUrl": "http://127.0.0.1:5104"
  }
}
