@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<h2 class="h4 text-danger">Algo ha fallado al procesar la petición.</h2>

@* El RequestId sale de Activity.Current?.Id, que es el traceparent del W3C: cuando 7.3
   correlacione los logs por TraceId, este es el valor que el usuario puede copiar y pegar
   para que se encuentre su peticion en Jaeger. Por eso se conserva. *@
@if (Model.ShowRequestId)
{
    <p>
        <strong>Id de la petición:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3 class="h5">Entorno de desarrollo</h3>
<p>
    En el entorno <strong>Development</strong> esta página se sustituye por el detalle completo
    del error, con su traza de pila.
</p>
<p class="mb-0">
    <strong>Ese entorno no debe activarse en un despliegue real:</strong> expondría al usuario
    información sensible que sale dentro de las excepciones.
</p>
