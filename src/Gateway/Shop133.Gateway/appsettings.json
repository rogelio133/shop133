{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // --- Tabla de enrutado del Gateway (5.1) ---------------------------------
  //
  // Sí, este archivo lleva comentarios: el proveedor de configuración JSON de
  // ASP.NET Core parsea con JsonCommentHandling.Skip, así que son legales aquí
  // aunque no lo sean en JSON estricto. Se usan porque las decisiones de abajo
  // no se deducen leyendo los valores.
  //
  // La tabla vive en configuración y no en código (LoadFromConfig, no
  // LoadFromMemory) por dos motivos: es el idioma de YARP, y deja cada destino
  // sobreescribible por variable de entorno con el patrón de 1.6:
  //
  //   ReverseProxy__Clusters__catalog__Destinations__primary__Address
  //
  // que es como entrará el día que el Gateway tenga contenedor y los destinos
  // pasen a ser nombres de servicio de compose en vez de localhost.
  "ReverseProxy": {

    // Solo DOS rutas, y la ausencia de las otras tres es una decisión.
    //
    // El título del punto 5.1 dice "/api/catalog/*, /api/orders/*, etc. hacia
    // cada servicio", pero Inventory.API, Payments.API y Notifications.API no
    // tienen ni carpeta Controllers/: toda su superficie son consumers de
    // RabbitMQ. Una ruta hacia ellos solo podría devolver 404, y una regla que
    // nunca engancha es lo que 3.2 rechazó en los tests de arquitectura.
    // Entrarán aquí el día que alguno gane un controller.
    "Routes": {

      // El servicio es dueño de /products y /categories; el Gateway es dueño
      // del espacio /api/catalog. PathRemovePrefix es lo que une las dos cosas
      // sin que ninguna sepa de la otra.
      //
      // Descartado reescribir el [Route("[controller]")] de los controllers a
      // /api/catalog/products: eso metería la topología del Gateway dentro del
      // servicio y le impediría correr solo, que es lo contrario de lo que 2.3
      // dejó anotado sobre el prefijo.
      "catalog-route": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" }
        ]
      },

      // El catch-all también reenvía /api/catalog/openapi/v1.json y
      // /api/catalog/scalar, sin excepción explícita. Es la relectura que 1.5
      // encargó a esta fase, y se resuelve midiendo el desajuste en vez de
      // esconderlo: el documento que llega declara sus paths como /products, no
      // como /api/catalog/products. Ver docs/fase_5_1.md.

      // OJO: aqui el prefijo que se quita es /api y NO /api/orders, y la
      // asimetria con la ruta de arriba no es un descuido. Costo un 404.
      //
      // Para Catalog el prefijo publico es un espacio de nombres que el servicio
      // desconoce: /api/catalog/products se convierte en /products. Para Orders el
      // ULTIMO SEGMENTO DEL PREFIJO ES A LA VEZ EL RECURSO del servicio, que sirve
      // en /orders. Quitando /api/orders el path se queda VACIO y Orders.API
      // devuelve 404, porque no tiene ningun endpoint en la raiz.
      //
      // Quitando solo /api: /api/orders pasa a /orders y /api/orders/{id} pasa a
      // /orders/{id}, que es exactamente la superficie que pide el roadmap.
      //
      // La regla que queda: el transform no se copia de una ruta a otra, se deriva
      // de la relacion entre el prefijo publico y los paths que el servicio sirve
      // de verdad — y esa relacion es distinta en cada servicio.
      "orders-route": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      }
    },

    // Un destino por cluster, y sin HealthCheck, sin LoadBalancingPolicy y sin
    // SessionAffinity: no hay réplicas que balancear ni sesión que fijar, y
    // /health es de 8.4.
    //
    // Los puertos son los de launchSettings.json de cada servicio, o sea los del
    // IDE. El Gateway no tiene contenedor en 5.1 porque solo catalog-api está en
    // compose: desde dentro de Docker alcanzaría uno de sus dos destinos.
    //
    // Es HTTP y no HTTPS a propósito. Desde 5.1 la terminación TLS es del
    // Gateway —lo que 1.6 dejó escrito en el Program.cs de Catalog—, así que el
    // salto hacia el servicio va en claro y por eso 5.1 le quita a Catalog.API y
    // a Orders.API su UseHttpsRedirection(): con él puesto, este salto recibía un
    // 307 hacia https://localhost:7024 que además filtraba la dirección real del
    // servicio al cliente.
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5124/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5189/"
          }
        }
      }
    }
  }
}
