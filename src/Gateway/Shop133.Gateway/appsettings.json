{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // --- Orígenes permitidos por CORS (5.3) ----------------------------------
  //
  // Los dos perfiles de launchSettings.json de Shop133.Web, que es el único
  // origen de navegador que existirá cuando llegue la Fase 6. Lista estricta y la
  // misma en Development que en Production: lo que se prueba a diario tiene que
  // ser lo que se despliega.
  //
  // OJO CON LA BARRA FINAL: la cabecera Origin que manda el navegador nunca la
  // lleva y la comparación es literal, así que "http://localhost:5025/" no
  // engancha NUNCA y se ve exactamente igual que no haber configurado nada.
  // Program.cs revienta antes de app.Build() si algún origen la lleva, o si la
  // lista falta o está vacía.
  //
  // Sobreescribible por entorno con el patrón de siempre, un índice por elemento:
  //
  //   Cors__AllowedOrigins__0=https://shop133.example
  //
  // La política se llama "frontend" (la registra Program.cs) y cada ruta la
  // declara abajo con "CorsPolicy", igual que declara su "RateLimiterPolicy".
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5025",
      "https://localhost:7227"
    ]
  },

  // --- Cupos del rate limiting (5.2) ---------------------------------------
  //
  // Ventana fija por IP del cliente. Están aquí y no como literales en Program.cs
  // por el motivo de 5.4: bajar el umbral por variable de entorno es lo que
  // permite provocar el 429 sin crear diez pedidos de verdad.
  //
  //   RateLimiting__OrdersWrite__PermitLimit=3
  //
  // Cupos distintos porque el límite protege el COSTE, no el número de peticiones:
  // un GET al catálogo lee una tabla, un POST /orders arranca la saga entera
  // (cinco servicios, doce mensajes, cinco bases de datos).
  //
  // OrdersRead entra en 6.5 y es la deuda que 6.4 dejó aquí por escrito. Hasta
  // entonces había UNA sola ruta para /api/orders/*, así que GET /orders/{id}
  // gastaba permisos del cupo de ESCRITURA: 6.4 midió que el 429 llega en la
  // petición 11, o sea que un sondeo cada 2-3 s se quedaba sin cupo a los ~25
  // segundos de abrir la página. La ruta se parte por método ahí abajo.
  //
  // 60 es el mismo número que CatalogRead a propósito: una lectura es una lectura.
  // Lo que justificaba los 10 de OrdersWrite no era "es /orders", era que cada POST
  // arranca la saga; consultar en qué va un pedido es un SELECT de seis columnas.
  // Con el sondeo de 6.5 a 2 s son 30 por minuto, o sea la mitad del cupo.
  //
  // Global es la red de seguridad de lo que no declare política, y TIENE que
  // quedar por encima de TODOS los demás: cuando una ruta declara la suya se
  // aplican las dos, así que un global más bajo sería el que limita de verdad y
  // dejaría decorativas a las de arriba. 120 > 60 sigue cumpliéndose sin tocarlo, y
  // GatewayConfigurationTests.GlobalQuota_StaysAboveEveryRouteQuota lo vigila
  // enumerando las secciones que haya — la de OrdersRead incluida desde hoy.
  //
  // Program.cs revienta antes de app.Build() si falta cualquiera de los cuatro: un
  // PermitLimit de 0 —el valor por defecto de GetValue<int>— rechazaría todo con
  // 429 sin decir por qué.
  "RateLimiting": {
    "CatalogRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "OrdersRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "OrdersWrite": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },

  // --- Tabla de enrutado del Gateway (5.1) ---------------------------------
  //
  // Sí, este archivo lleva comentarios: el proveedor de configuración JSON de
  // ASP.NET Core parsea con JsonCommentHandling.Skip, así que son legales aquí
  // aunque no lo sean en JSON estricto. Se usan porque las decisiones de abajo
  // no se deducen leyendo los valores.
  //
  // La tabla vive en configuración y no en código (LoadFromConfig, no
  // LoadFromMemory) por dos motivos: es el idioma de YARP, y deja cada destino
  // sobreescribible por variable de entorno con el patrón de 1.6:
  //
  //   ReverseProxy__Clusters__catalog__Destinations__primary__Address
  //
  // que es como entrará el día que el Gateway tenga contenedor y los destinos
  // pasen a ser nombres de servicio de compose en vez de localhost.
  "ReverseProxy": {

    // Solo DOS rutas, y la ausencia de las otras tres es una decisión.
    //
    // El título del punto 5.1 dice "/api/catalog/*, /api/orders/*, etc. hacia
    // cada servicio", pero Inventory.API, Payments.API y Notifications.API no
    // tienen ni carpeta Controllers/: toda su superficie son consumers de
    // RabbitMQ. Una ruta hacia ellos solo podría devolver 404, y una regla que
    // nunca engancha es lo que 3.2 rechazó en los tests de arquitectura.
    // Entrarán aquí el día que alguno gane un controller.
    "Routes": {

      // El servicio es dueño de /products y /categories; el Gateway es dueño
      // del espacio /api/catalog. PathRemovePrefix es lo que une las dos cosas
      // sin que ninguna sepa de la otra.
      //
      // Descartado reescribir el [Route("[controller]")] de los controllers a
      // /api/catalog/products: eso metería la topología del Gateway dentro del
      // servicio y le impediría correr solo, que es lo contrario de lo que 2.3
      // dejó anotado sobre el prefijo.
      //
      // RateLimiterPolicy (5.2): el nombre lo registra Program.cs. Cupo generoso
      // — son lecturas contra una tabla. Y el nombre está vigilado: si no coincide
      // con ninguna política registrada, YARP NO arranca (medido: "Unable to load
      // or apply the proxy configuration"). Es la razón de que no haga falta una
      // guarda propia como la de más abajo — este fallo ya es ruidoso.
      "catalog-route": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "RateLimiterPolicy": "catalog-read",
        // CorsPolicy (5.3): sin esta línea YARP ni siquiera engancha el preflight
        // de esta ruta ("If not set then the route won't be automatically matched
        // for cors preflight requests", XML del paquete), así que el navegador la
        // bloquearía. "Default" y "Disable" son nombres reservados de YARP.
        "CorsPolicy": "frontend",
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" }
        ]
      },

      // El catch-all también reenvía /api/catalog/openapi/v1.json y
      // /api/catalog/scalar, sin excepción explícita. Es la relectura que 1.5
      // encargó a esta fase, y se resuelve midiendo el desajuste en vez de
      // esconderlo: el documento que llega declara sus paths como /products, no
      // como /api/catalog/products. Ver docs/fase_5_1.md.

      // OJO: aqui el prefijo que se quita es /api y NO /api/orders, y la
      // asimetria con la ruta de arriba no es un descuido. Costo un 404.
      //
      // Para Catalog el prefijo publico es un espacio de nombres que el servicio
      // desconoce: /api/catalog/products se convierte en /products. Para Orders el
      // ULTIMO SEGMENTO DEL PREFIJO ES A LA VEZ EL RECURSO del servicio, que sirve
      // en /orders. Quitando /api/orders el path se queda VACIO y Orders.API
      // devuelve 404, porque no tiene ningun endpoint en la raiz.
      //
      // Quitando solo /api: /api/orders pasa a /orders y /api/orders/{id} pasa a
      // /orders/{id}, que es exactamente la superficie que pide el roadmap.
      //
      // La regla que queda: el transform no se copia de una ruta a otra, se deriva
      // de la relacion entre el prefijo publico y los paths que el servicio sirve
      // de verdad — y esa relacion es distinta en cada servicio.
      //
      // ── 6.5 PARTE ESTA RUTA EN DOS, Y LO ÚNICO QUE LAS DISTINGUE ES EL MÉTODO ──
      //
      // Hasta aquí había una sola "orders-route" con el cupo orders-write, así que
      // LEER un pedido gastaba permisos de CREARLO. 6.4 lo midió y dejó la decisión
      // escrita para este punto: "o el sondeo es mucho más lento, o orders-route se
      // parte en dos rutas con dos cupos". Se parte.
      //
      // Las dos comparten cluster, path y transform; SOLO cambian "Methods" y
      // "RateLimiterPolicy". Y el transform hay que COPIARLO en las dos: quita /api
      // y NO /api/orders, por el 404 que eso costó en 5.1 (ver el comentario largo
      // de abajo). Es exactamente el tipo de línea que se deduce mal.
      //
      // *Descartada* una ruta específica para /api/orders/{id}/status con el cupo de
      // lectura, dejando el resto como estaba: habría partido el cupo por RECURSO en
      // vez de por COSTE, y GET /api/orders/{id} —que es igual de barato— se habría
      // quedado en el cupo de escritura sin ningún motivo. Además YARP no tiene
      // precedencia por especificidad entre dos rutas con el mismo path, así que
      // haría falta un "Order" explícito que nada vigila.
      //
      // La consecuencia, dicha en voz alta: con las dos rutas restringidas por
      // método, un PUT o un DELETE sobre /api/orders/* pasa a dar 404 EN EL GATEWAY
      // en vez de llegar al servicio. Hoy no existe ninguno de los dos, y el día que
      // exista la ruta que lo sirva es una decisión, no un descuido.

      // Cupo mucho más estricto que el de catalog (5.2), y la asimetría es la
      // decisión, no un descuido: cada POST que pasa por aquí arranca la saga
      // entera. El límite protege el coste, no el número de peticiones.
      "orders-write-route": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "POST" ]
        },
        "RateLimiterPolicy": "orders-write",
        // La misma política que catalog: el origen permitido es el mismo y CORS
        // no distingue coste, que es lo que sí distinguen los cupos de 5.2.
        // Aquí el preflight importa de verdad: POST con Content-Type
        // application/json no es una petición simple, así que el navegador manda
        // un OPTIONS antes de cada pedido.
        //
        // Con "Methods" puesto, YARP marca el endpoint como aceptador de preflight
        // porque la ruta declara CorsPolicy, así que el OPTIONS sigue enganchando
        // aunque el método del preflight no sea POST sino la cabecera
        // Access-Control-Request-Method. Sin CorsPolicy no engancharía.
        "CorsPolicy": "frontend",
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },

      // La mitad de lectura. GET /api/orders/{id} y GET /api/orders/{id}/status —el
      // endpoint que 6.5 estrena en Orders.API y que la página sondea cada 2 s.
      "orders-read-route": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "RateLimiterPolicy": "orders-read",
        "CorsPolicy": "frontend",
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      }
    },

    // Un destino por cluster, y sin HealthCheck, sin LoadBalancingPolicy y sin
    // SessionAffinity: no hay réplicas que balancear ni sesión que fijar, y
    // /health es de 8.4.
    //
    // Los puertos son los de launchSettings.json de cada servicio, o sea los del
    // IDE. El Gateway no tiene contenedor en 5.1 porque solo catalog-api está en
    // compose: desde dentro de Docker alcanzaría uno de sus dos destinos.
    //
    // Es HTTP y no HTTPS a propósito. Desde 5.1 la terminación TLS es del
    // Gateway —lo que 1.6 dejó escrito en el Program.cs de Catalog—, así que el
    // salto hacia el servicio va en claro y por eso 5.1 le quita a Catalog.API y
    // a Orders.API su UseHttpsRedirection(): con él puesto, este salto recibía un
    // 307 hacia https://localhost:7024 que además filtraba la dirección real del
    // servicio al cliente.
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5124/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5189/"
          }
        }
      }
    }
  }
}
